{
  "name": "starhub",
  "productName": "StarHub",
  "version": "1.2.3",
  "description": "GitHub 高星项目聚合桌面客户端：分类浏览、Star/下载量排序、应用内预览、中文化、收藏与点赞",
  "main": "src/main/main.js",
  "author": "StarHub",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "node scripts/prepare-vendor.js",
    "pack": "node scripts/package-win.js",
    "dist:installer": "node scripts/package-installer.js",
    "dist:unpacked": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "dompurify": "^3.1.7",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  }
}
